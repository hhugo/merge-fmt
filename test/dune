(library
 (name merge_fmt_test)
 (modules :standard \ setup_jj)
 (libraries base stdio unix)
 (inline_tests
  (deps ../src/merge_fmt.exe))
 (preprocess
  (pps ppx_devtools-expect)))

;; Tests that need jj. They are skipped when jj is not installed.

(library
 (name merge_fmt_test_jj)
 (modules setup_jj)
 (enabled_if %{bin-available:jj})
 (libraries base stdio unix merge_fmt_test)
 (inline_tests
  (deps ../src/merge_fmt.exe))
 (preprocess
  (pps ppx_devtools-expect)))

;; [rebase_a.ml] and [rebase_b.ml] should be the same expect that
;; [rebase_b.ml] does rebase in an intermediate revision.

(rule
 (targets rebase.diff.gen)
 (action
  (with-stdout-to
   %{targets}
   (bash "diff %{dep:rebase_a.ml} %{dep:rebase_b.ml} || true"))))

(rule
 (alias runtest)
 (action
  (diff rebase.diff rebase.diff.gen)))
